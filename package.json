{
  "name": "@visual-regression-tracker/agent-playwright",
  "version": "0.0.0-development",
  "description": "Native integration for Playwright with Visual Regression Tracker",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "tsc -p tsconfig.spec.json && vitest run",
    "test:cov": "tsc -p tsconfig.spec.json && vitest run --coverage",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Visual-Regression-Tracker/agent-playwright.git"
  },
  "keywords": [
    "visual-regression-tracker",
    "visual-regression",
    "playwright"
  ],
  "author": "Pavel Strunkin",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Visual-Regression-Tracker/agent-playwright/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "homepage": "https://github.com/Visual-Regression-Tracker/agent-playwright#readme",
  "dependencies": {
    "@visual-regression-tracker/sdk-js": "^5.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "release": {
    "branches": [
      "master",
      {
        "name": "next",
        "prerelease": "rc"
      }
    ],
    "preset": "conventionalcommits"
  }
}
